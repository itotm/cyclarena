; paintarena installer for Windows (NSIS 3). Built by scripts/dist.ts, which
; passes VERSION, SRCDIR, OUTFILE and ICON with -D.
; Per-user installation, no administrator rights needed.

Unicode true
!include "MUI2.nsh"

Name "paintarena ${VERSION}"
OutFile "${OUTFILE}"
InstallDir "$LOCALAPPDATA\Programs\paintarena"
InstallDirRegKey HKCU "Software\paintarena" "InstallDir"
RequestExecutionLevel user
SetCompressor /SOLID lzma
BrandingText "paintarena ${VERSION}"

VIProductVersion "${VERSION}.0"
VIAddVersionKey /LANG=0 "ProductName" "paintarena"
VIAddVersionKey /LANG=0 "FileDescription" "paintarena setup"
VIAddVersionKey /LANG=0 "FileVersion" "${VERSION}"
VIAddVersionKey /LANG=0 "ProductVersion" "${VERSION}"
VIAddVersionKey /LANG=0 "LegalCopyright" "GNU GPL v3 or later"

!define MUI_ICON "${ICON}"
!define MUI_UNICON "${ICON}"
!define MUI_ABORTWARNING
!define MUI_FINISHPAGE_RUN "$INSTDIR\paintarena.exe"

!insertmacro MUI_PAGE_WELCOME
!insertmacro MUI_PAGE_LICENSE "${SRCDIR}\LICENSE.txt"
!insertmacro MUI_PAGE_COMPONENTS
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_PAGE_FINISH
!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES

!insertmacro MUI_LANGUAGE "Italian"
!insertmacro MUI_LANGUAGE "English"

LangString SecMain ${LANG_ITALIAN} "paintarena (gioco e riga di comando)"
LangString SecMain ${LANG_ENGLISH} "paintarena (game and command line)"
LangString SecDesktop ${LANG_ITALIAN} "Collegamento sul desktop"
LangString SecDesktop ${LANG_ENGLISH} "Desktop shortcut"
LangString CmdLink ${LANG_ITALIAN} "paintarena - riga di comando"
LangString CmdLink ${LANG_ENGLISH} "paintarena - command line"
LangString RobotsLink ${LANG_ITALIAN} "Robot di esempio"
LangString RobotsLink ${LANG_ENGLISH} "Example robots"
LangString UninstLink ${LANG_ITALIAN} "Disinstalla paintarena"
LangString UninstLink ${LANG_ENGLISH} "Uninstall paintarena"

!define UNINST_KEY "Software\Microsoft\Windows\CurrentVersion\Uninstall\paintarena"

Section "!$(SecMain)" SEC_MAIN
  SectionIn RO
  SetOutPath "$INSTDIR"
  File /r "${SRCDIR}\*.*"
  WriteUninstaller "$INSTDIR\uninstall.exe"
  WriteRegStr HKCU "Software\paintarena" "InstallDir" "$INSTDIR"

  CreateDirectory "$SMPROGRAMS\paintarena"
  CreateShortcut "$SMPROGRAMS\paintarena\paintarena.lnk" "$INSTDIR\paintarena.exe" "" "$INSTDIR\paintarena.ico"
  CreateShortcut "$SMPROGRAMS\paintarena\$(CmdLink).lnk" "$SYSDIR\cmd.exe" '/k cd /d "$INSTDIR" && paintarena help' "$INSTDIR\paintarena.ico"
  CreateShortcut "$SMPROGRAMS\paintarena\$(RobotsLink).lnk" "$INSTDIR\robots"
  CreateShortcut "$SMPROGRAMS\paintarena\$(UninstLink).lnk" "$INSTDIR\uninstall.exe"

  WriteRegStr HKCU "${UNINST_KEY}" "DisplayName" "paintarena"
  WriteRegStr HKCU "${UNINST_KEY}" "DisplayVersion" "${VERSION}"
  WriteRegStr HKCU "${UNINST_KEY}" "Publisher" "paintarena"
  WriteRegStr HKCU "${UNINST_KEY}" "DisplayIcon" "$INSTDIR\paintarena.ico"
  WriteRegStr HKCU "${UNINST_KEY}" "InstallLocation" "$INSTDIR"
  WriteRegStr HKCU "${UNINST_KEY}" "UninstallString" '"$INSTDIR\uninstall.exe"'
  WriteRegDWORD HKCU "${UNINST_KEY}" "NoModify" 1
  WriteRegDWORD HKCU "${UNINST_KEY}" "NoRepair" 1
SectionEnd

Section "$(SecDesktop)" SEC_DESKTOP
  CreateShortcut "$DESKTOP\paintarena.lnk" "$INSTDIR\paintarena.exe" "" "$INSTDIR\paintarena.ico"
SectionEnd

Section "Uninstall"
  Delete "$DESKTOP\paintarena.lnk"
  RMDir /r "$SMPROGRAMS\paintarena"
  ; only the installed files are deleted (list generated by scripts/dist.ts), never
  ; the whole folder: the user may have chosen one inside their documents
  !include "${FILELIST}"
  Delete "$INSTDIR\uninstall.exe"
  RMDir "$INSTDIR"
  DeleteRegKey HKCU "${UNINST_KEY}"
  DeleteRegKey HKCU "Software\paintarena"
SectionEnd
